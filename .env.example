# .env.example (Template)

# --- Server-Side Secrets (NEVER exposed to browser) ---
# Connection string for PostgreSQL (pooled connection for app)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Direct URL for Prisma migrations (non-pooled connection)
DIRECT_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT Secret for authentication (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Redis URL for caching
REDIS_URL=redis://localhost:6379

# Google OAuth (optional - for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Client-Side Variables (Safe to expose) ---
# Must start with 'NEXT_PUBLIC_'
NEXT_PUBLIC_ENV_NAME=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME="Rural School Portal"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id