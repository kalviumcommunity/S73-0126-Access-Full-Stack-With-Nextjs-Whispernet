# Copy to .env.local and fill in. Never commit a file with real secrets.

# --- Required ----------------------------------------------------------------

# PostgreSQL. DIRECT_URL is used for migrations; with a connection pooler
# (PgBouncer, Neon, Supabase) point DATABASE_URL at the pooler and DIRECT_URL
# at the database itself. Locally they are the same.
DATABASE_URL="postgresql://postgres:password@localhost:5432/rural_school_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/rural_school_db?schema=public"

# Signing key for session tokens. Must be at least 32 characters — the app
# refuses to issue tokens otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"

# --- Optional ----------------------------------------------------------------

# Redis. Purely a cache: if this is unset or unreachable the app still works,
# it just reads from PostgreSQL every time.
REDIS_URL="redis://localhost:6379"

# Google Sign-In. Leave both blank to hide the Google button entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
