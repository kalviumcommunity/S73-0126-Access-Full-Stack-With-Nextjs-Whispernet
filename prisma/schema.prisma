// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NoticeCategory {
  GENERAL
  ACADEMIC
  EXAM
  EVENT
  SPORTS
  HOLIDAY
  FACILITY
  MEETING
}

enum NoticePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Staff accounts: teachers and administrators.
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String  @default("") // empty for OAuth-only accounts
  phone    String?
  role     Role    @default(TEACHER)

  // OAuth
  googleId     String? @unique
  avatar       String?
  authProvider String  @default("email") // "email" | "google"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  notices       Notice[]
  markedRecords Attendance[] @relation("MarkedBy")

  @@index([role])
  @@index([googleId])
}

/// A pupil enrolled at the school.
model Student {
  id            Int     @id @default(autoincrement())
  name          String
  rollNumber    String?
  grade         Int // 1..12
  section       String  @default("A")
  guardianName  String?
  guardianPhone String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  attendance Attendance[]

  @@unique([grade, section, rollNumber])
  @@index([grade])
  @@index([grade, section])
  @@index([isActive])
  @@index([name])
}

/// One attendance record per student per school day.
model Attendance {
  id     Int              @id @default(autoincrement())
  /// Normalised to midnight UTC so a day has exactly one record per student.
  date   DateTime         @db.Date
  status AttendanceStatus @default(PRESENT)
  note   String?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  markedById Int?
  markedBy   User? @relation("MarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@index([status, date])
}

/// School announcements shown on the public notice board.
model Notice {
  id       Int            @id @default(autoincrement())
  title    String
  content  String
  category NoticeCategory @default(GENERAL)
  priority NoticePriority @default(NORMAL)
  isPinned Boolean        @default(false)
  isActive Boolean        @default(true)

  /// Display name of the desk that issued the notice (e.g. "Examination Cell").
  authorName String
  authorId   Int?
  author     User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, publishedAt])
  @@index([category])
  @@index([isPinned])
}
